<div class="history-page">

    <!-- Header -->
    <div class="page-header">
        <div>
            <span class="page-tag">AI CONVERSATIONS</span>
            <h1>Historique des conversations</h1>
            <p>Retrouvez toutes les conversations enregistrées avec votre Assistant IA.</p>
        </div>

        <button class="new-chat-btn">
            <i class="fas fa-plus"></i>
            Nouvelle conversation
        </button>
    </div>

    <!-- Search -->
    <div class="search-section">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text"
                   placeholder="Rechercher une conversation..." />
        </div>
    </div>

    <!-- History List -->
    <div class="history-container">

        <div class="history-card">

            <div class="history-info">
                <div class="history-icon">
                    <i class="fas fa-robot"></i>
                </div>

                <div>
                    <h3>Analyse des ventes Q3</h3>
                    <p>
                        Résumé généré automatiquement concernant les ventes
                        du troisième trimestre.
                    </p>
                </div>
            </div>

            <div class="history-meta">
                <span>16/11/2026</span>
                <span>14:45</span>
            </div>

            <div class="history-actions">
                <button class="btn-open">
                    Ouvrir
                </button>

                <button class="btn-delete">
                    Supprimer
                </button>
            </div>

        </div>

        <div class="history-card">

            <div class="history-info">
                <div class="history-icon">
                    <i class="fas fa-file-alt"></i>
                </div>

                <div>
                    <h3>Rapport RH</h3>
                    <p>
                        Conversation relative à l'analyse RH et aux statistiques.
                    </p>
                </div>
            </div>

            <div class="history-meta">
                <span>15/11/2026</span>
                <span>10:20</span>
            </div>

            <div class="history-actions">
                <button class="btn-open">
                    Ouvrir
                </button>

                <button class="btn-delete">
                    Supprimer
                </button>
            </div>

        </div>

        <div class="history-card">

            <div class="history-info">
                <div class="history-icon">
                    <i class="fas fa-chart-line"></i>
                </div>

                <div>
                    <h3>Prévisions financières</h3>
                    <p>
                        Estimations et indicateurs financiers générés par l’IA.
                    </p>
                </div>
            </div>

            <div class="history-meta">
                <span>14/11/2026</span>
                <span>17:30</span>
            </div>

            <div class="history-actions">
                <button class="btn-open">
                    Ouvrir
                </button>

                <button class="btn-delete">
                    Supprimer
                </button>
            </div>

        </div>

    </div>

</div>